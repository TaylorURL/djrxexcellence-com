# The Supabase project the site reads. Both values are public: the publishable
# key is what the browser ships, and row-level security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only scripts/seed.js and scripts/verify-policies.js read these. They are the
# throwaway accounts those two scripts sign in as; nothing in src/ touches them.
SEED_AGENT_EMAIL=
SEED_AGENT_PASSWORD=
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=
