# Secrets and key material. The rules above cover .env, .env.local and the
# per-mode locals; this catches every other suffix, and .env.production would
# carry the seed accounts' passwords. The example file stays tracked.
.env.*
!.env.example
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

